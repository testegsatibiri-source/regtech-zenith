# ============================================================================
# regtech-zenith — environment variable matrix
# ----------------------------------------------------------------------------
# Copy to `.env` for local development. NEVER commit real values.
#
# | Variable                       | Lovable (preview/published) | External staging (Vercel + own Supabase) | External prod (Vercel + uboard-prod) |
# |--------------------------------|-----------------------------|------------------------------------------|--------------------------------------|
# | VITE_SUPABASE_URL              | auto-injected by platform   | https://<staging-ref>.supabase.co        | https://<prod-ref>.supabase.co       |
# | VITE_SUPABASE_PUBLISHABLE_KEY  | auto-injected by platform   | staging publishable (anon) key           | prod publishable (anon) key          |
# | VITE_SUPABASE_PROJECT_ID       | auto-injected by platform   | staging project ref                      | prod project ref                     |
# | SUPABASE_URL                   | auto-injected by platform   | same as VITE_SUPABASE_URL (server fns)   | same (server fns)                    |
# | SUPABASE_PUBLISHABLE_KEY       | auto-injected by platform   | staging publishable key (server fns)     | prod publishable key                 |
# | SUPABASE_SERVICE_ROLE_KEY      | auto-injected by platform   | staging service_role — GitHub/Vercel     | prod service_role — GitHub/Vercel    |
# |                                |                             | secret ONLY, never in Git/frontend       | secret ONLY, never in Git/frontend   |
# | LOVABLE_API_KEY                | platform-issued (AI gw)     | not available — use own AI provider key  | not available — own AI provider key  |
# | BUILD_TARGET                   | absent (= Lovable/Cloudflare)| "vercel" in CI                          | "vercel" in CI                       |
# | AI_PROVIDER_API_KEY            | n/a (LOVABLE_API_KEY)       | own provider key, server-only secret     | own provider key, server-only secret |
# | PACK_SIGNING_PRIVATE_KEY       | n/a                         | NEVER in Git/db/frontend — local signer  | same                                 |
# ============================================================================

# --- Client (safe to expose; Vite inlines VITE_* into the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server functions only (never shipped to the client bundle) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Build ---
# Unset = Lovable/Cloudflare. Set to "vercel" only in the external CI pipeline.
# BUILD_TARGET=vercel

# --- AI (Etapa 8: single provider module, server-only, no key in frontend) ---
# AI_PROVIDER_API_KEY=
